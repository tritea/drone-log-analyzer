{
  "format": "apm",
  "version": 1,
  "groups": {
    "GPS": {
      "description": "GPS 定位：卫星质量、位置、速度与航向，是导航与 EKF 位置估计的基础",
      "affects": ["position", "navigation", "ekf"],
      "fields": {
        "NSats": {
          "description": "可见卫星数量",
          "unit": "count",
          "thresholds": [
            { "level": "warning", "op": "lt", "value": 8 },
            { "level": "critical", "op": "lt", "value": 5 }
          ],
          "affects": ["position", "navigation"],
          "analysis": [
            { "condition": "NSats 下降 && HDop 升高", "meaning": "GPS 信号质量下降" },
            { "condition": "NSats 骤降至 0 且持续", "meaning": "GPS 失锁，位置估计退化为航位推算" }
          ],
          "related": ["GPS.HDop", "GPS.Status"]
        },
        "HDop": {
          "description": "水平精度因子，越小定位几何越好",
          "unit": "",
          "thresholds": [
            { "level": "warning", "op": "gt", "value": 2 },
            { "level": "critical", "op": "gt", "value": 5 }
          ],
          "affects": ["position", "ekf"],
          "analysis": [
            { "condition": "HDop 持续偏高（>2）", "meaning": "定位几何差，水平位置漂移风险" }
          ],
          "related": ["GPS.NSats", "GPA.HAcc"]
        },
        "Status": { "description": "定位状态", "unit": "enum", "values": ["0=未连接","1=有信号无锁","2=2D","3=3D","4=DGPS","5=RTK浮点","6=RTK固定","7=静态","8=PPP"], "affects": ["position","navigation"], "analysis": [{"condition":"Status 掉回 0/1","meaning":"定位丢失或降级，高度/速度不可信"},{"condition":"Status=6 且突然掉到 3","meaning":"RTK 失锁，精度从厘米级跌到米级"}] },
        "Lat": { "description": "纬度（度）", "unit": "deg", "affects": ["position"] },
        "Lng": { "description": "经度（度）", "unit": "deg", "affects": ["position"] },
        "Alt": { "description": "GPS 海拔高度（MSL，米；接收机已做大地水准面换算）", "unit": "m", "affects": ["position"], "related": ["BARO.Alt", "CTUN.BAlt"] },
        "Spd": { "description": "地速（米/秒）", "unit": "m/s", "affects": ["navigation"] },
        "GCrs": { "description": "地面航向（度，0=北）", "unit": "deg", "affects": ["navigation"] },
        "VZ": { "description": "垂直速度（米/秒，正=上升）", "unit": "m/s", "affects": ["position"] },
        "Yaw": { "description": "GPS 双天线航向（度）；无双天线时不可用", "unit": "deg", "affects": ["heading"], "related": ["ATT.Yaw"] }
      }
    },
    "GPA": {
      "description": "GPS 精度信息：精度因子与精度估计（比 GPS 组的 HDop 更细）",
      "affects": ["position", "ekf"],
      "fields": {
        "VDop": { "description": "垂直精度因子", "unit": "" },
        "HAcc": {
          "description": "水平位置精度（米）",
          "unit": "m",
          "thresholds": [
            { "level": "warning", "op": "gt", "value": 2 },
            { "level": "critical", "op": "gt", "value": 5 }
          ],
          "affects": ["position"]
        },
        "VAcc": { "description": "垂直位置精度（米）", "unit": "m" },
        "SAcc": { "description": "速度精度（米/秒）", "unit": "m/s" },
        "YAcc": { "description": "航向精度（度，双天线）", "unit": "deg" },
        "Delta": { "description": "两次定位间的系统时间差（毫秒）", "unit": "ms" }
      }
    },
    "BAT": {
      "description": "动力电池：电压/电流/累计电量/剩余估计，判断续航与电池健康",
      "affects": ["power", "duration", "safety"],
      "vehicleNotes": {
        "rover": "Rover 电流较小，电压下垂不明显，重点看 CurrTot 与续航",
        "sub": "水下低温环境下电压下垂更快，临界阈值应上调"
      },
      "fields": {
        "Volt": {
          "description": "电池瞬时电压（V）。锂电按每芯判断：warning≈3.5V/芯、critical≈3.3V/芯，按实际 S 数换算（如 4S：14.0/13.2）",
          "unit": "V",
          "affects": ["power", "safety"],
          "analysis": [
            { "condition": "Volt 随时间持续下降且斜率陡", "meaning": "正常放电或容量不足；斜率异常陡=电池老化/过载" },
            { "condition": "Volt 骤降伴随大 Curr", "meaning": "电池内阻大或放电能力不足（C 数不够）" }
          ],
          "related": ["BAT.VoltR", "BAT.Curr", "BCL.V1"]
        },
        "VoltR": {
          "description": "静态（无负载）电池电压（V），用于判断电池真实余量与内阻",
          "unit": "V",
          "affects": ["power"],
          "analysis": [
            { "condition": "VoltR 明显低于同电量 Volt 预期", "meaning": "电池老化，内阻增大" }
          ]
        },
        "Curr": {
          "description": "瞬时电流（A）",
          "unit": "A",
          "affects": ["power"],
          "analysis": [
            { "condition": "悬停电流比历史基线明显偏高", "meaning": "机械阻力增大（轴承/桨损）或超载" }
          ]
        },
        "CurrTot": {
          "description": "累计消耗电量（mAh）",
          "unit": "mAh",
          "affects": ["duration"],
          "analysis": [
            { "condition": "CurrTot 变化率 = 平均功耗", "meaning": "结合电池容量估算剩余续航" }
          ]
        },
        "EnrgTot": { "description": "累计消耗能量（Wh）", "unit": "Wh", "affects": ["duration"] },
        "Res": { "description": "估算电池内阻（欧姆），越大电池越老化", "unit": "ohm" },
        "RemPct": { "description": "剩余电量百分比（%）", "unit": "percent", "affects": ["duration", "safety"] },
        "Temp": { "description": "电池温度（℃）", "unit": "celsius" },
        "SH": { "description": "电池健康状态（%，0=未知）", "unit": "percent" }
      }
    },
    "BCL": {
      "description": "智能电池单芯电压：判断电芯失衡与真实余量",
      "affects": ["power", "safety"],
      "fields": {
        "V1": {
          "description": "第 1 芯电芯电压（mV）。单芯 warning≈3500mV、critical≈3300mV",
          "unit": "mV",
          "thresholds": [
            { "level": "warning", "op": "lt", "value": 3500 },
            { "level": "critical", "op": "lt", "value": 3300 }
          ],
          "affects": ["power", "safety"],
          "analysis": [
            { "condition": "各芯最大最小差 >50mV 且逐渐扩大", "meaning": "电芯失衡，电池老化或有坏芯" }
          ]
        }
      }
    },
    "CTUN": {
      "description": "高度/油门控制通道：期望与实际高度、油门输出，判断垂向控制品质",
      "affects": ["altitude", "throttle", "landing"],
      "fields": {
        "ThO": {
          "description": "油门输出（0~1，4.x 字段名；3.x 叫 ThrOut）。多旋翼悬停值偏高说明效率差或超载",
          "unit": "norm",
          "affects": ["throttle", "power"],
          "analysis": [
            { "condition": "悬停 ThO 持续 >0.7", "meaning": "电机/桨效率低或机体重载，抗风余量不足" },
            { "condition": "ThO 饱和且高度仍掉", "meaning": "动力不足，存在失控风险" }
          ],
          "related": ["MOTB.ThrOut", "RCOU.C1"]
        },
        "ThrOut": {
          "description": "油门输出（%，3.x 字段名；4.x 叫 ThO）",
          "unit": "percent",
          "affects": ["throttle", "power"],
          "analysis": [
            { "condition": "悬停 ThrOut 持续 >70%", "meaning": "电机/桨效率低或机体重载" }
          ]
        },
        "ThI": { "description": "飞行员油门输入（0~1）", "unit": "norm", "affects": ["throttle"] },
        "ThH": { "description": "估算的悬停油门（0~1）；与实际悬停 ThO 偏差大说明 MOT_THST_HOVER 未校准", "unit": "norm", "affects": ["throttle"] },
        "ABst": { "description": "大角度时的油门提升量", "unit": "norm", "affects": ["throttle"] },
        "DAlt": { "description": "期望高度（米，相对 HOME）", "unit": "m", "affects": ["altitude"] },
        "Alt": {
          "description": "实际（EKF）高度（米，相对 HOME）",
          "unit": "m",
          "affects": ["altitude"],
          "analysis": [
            { "condition": "排查掉高/高度跳变", "meaning": "先查参数 EK3_SRC1_POSZ 确认高度源（0=气压计 1=测距仪 2=GPS 3=GPS+气压融合），再对照该源原始数据（BARO.Alt / RFND.Dist / GPS.Alt）与 EKF 估计，区分是源跳变还是融合异常" },
            { "condition": "GPS 高度源且 RTK 状态变化时掉高", "meaning": "RTK Fix→Float 降级使 GPS 垂直精度突变，优先查 GPS.NSats/HDop 与 RTK 状态" }
          ]
        },
        "BAlt": {
          "description": "气压计高度（米，相对 HOME；4.x 叫 BAlt，3.x 叫 BarAlt）",
          "unit": "m",
          "affects": ["altitude"],
          "analysis": [
            { "condition": "BAlt 与 GPS.Alt 长期发散", "meaning": "气压漂移（天气/气流）或气压计遮挡" }
          ],
          "related": ["GPS.Alt"]
        },
        "BarAlt": { "description": "气压计高度（米，3.x 字段名；4.x 叫 BAlt）", "unit": "m", "affects": ["altitude"] },
        "DSAlt": { "description": "期望测距仪高度（米，相对地面）", "unit": "m", "appliesTo": ["multirotor", "helicopter", "vtol"], "affects": ["altitude"] },
        "SAlt": { "description": "测距仪高度（米，相对地面）", "unit": "m", "appliesTo": ["multirotor", "helicopter", "vtol"], "affects": ["altitude"], "related": ["RFND.Dist"] },
        "TAlt": { "description": "地形高度（米，地形跟随启用时）", "unit": "m", "affects": ["altitude"], "related": ["TERR.CHeight"] },
        "DCRt": { "description": "期望爬升率（米/秒；4.x 叫 DCRt，3.x 部分版本无）", "unit": "m/s", "affects": ["altitude"] },
        "CRt": { "description": "实际爬升率（米/秒，正=上升）", "unit": "m/s", "appliesTo": ["multirotor", "helicopter", "vtol"], "affects": ["altitude"] }
      }
    },
    "ATT": {
      "description": "姿态：实际与期望的 Roll/Pitch/Yaw，判断姿态跟踪与振动水平",
      "affects": ["attitude", "stability", "vibration"],
      "fields": {
        "Roll": { "description": "实际横滚角（度）", "unit": "deg", "affects": ["attitude"], "related": ["ATT.DesRoll"] },
        "DesRoll": {
          "description": "期望横滚角（度）",
          "unit": "deg",
          "affects": ["attitude"],
          "analysis": [
            { "condition": "|Roll - DesRoll| 持续偏大", "meaning": "横滚跟踪差：增益低、振动或机械问题" }
          ],
          "related": ["ATT.Roll"]
        },
        "Pitch": { "description": "实际俯仰角（度）", "unit": "deg", "affects": ["attitude"], "related": ["ATT.DesPitch"] },
        "DesPitch": {
          "description": "期望俯仰角（度）",
          "unit": "deg",
          "affects": ["attitude"],
          "analysis": [
            { "condition": "|Pitch - DesPitch| 持续偏大", "meaning": "俯仰跟踪差：重心偏、增益低或风扰" }
          ],
          "related": ["ATT.Pitch"]
        },
        "Yaw": { "description": "实际偏航角（度）", "unit": "deg", "affects": ["heading"], "related": ["ATT.DesYaw"] },
        "DesYaw": {
          "description": "期望偏航角（度）",
          "unit": "deg",
          "affects": ["heading"],
          "analysis": [
            { "condition": "Yaw 缓慢单方向漂移", "meaning": "磁力计干扰或 GPS 航向不准" }
          ],
          "related": ["ATT.Yaw"]
        },
        "AEKF": { "description": "当前使用的 EKF 类型标识", "unit": "" }
      }
    },
    "RATE": {
      "description": "姿态角速率控制：期望与实际的 Roll/Pitch/Yaw 角速率与输出，调参诊断核心",
      "affects": ["attitude", "stability"],
      "appliesTo": ["multirotor", "helicopter", "vtol", "sub"],
      "fields": {
        "RDes": { "description": "期望横滚角速率（度/秒）", "unit": "deg/s", "related": ["RATE.R"] },
        "R": { "description": "实际横滚角速率（度/秒）", "unit": "deg/s" },
        "PDes": { "description": "期望俯仰角速率（度/秒）", "unit": "deg/s", "related": ["RATE.P"] },
        "P": { "description": "实际俯仰角速率（度/秒）", "unit": "deg/s" },
        "YDes": { "description": "期望偏航角速率（度/秒）", "unit": "deg/s", "related": ["RATE.Y"] },
        "Y": { "description": "实际偏航角速率（度/秒）", "unit": "deg/s" },
        "ROut": { "description": "横滚通道归一化输出", "unit": "norm" },
        "POut": { "description": "俯仰通道归一化输出", "unit": "norm" },
        "YOut": { "description": "偏航通道归一化输出", "unit": "norm" },
        "ADes": { "description": "期望垂直加速度（cm/s²）", "unit": "cm/s/s" },
        "AOut": { "description": "垂直推力输出百分比", "unit": "percent" }
      }
    },
    "VIBE": {
      "description": "振动（主加速度计滤波后的振动水平）——多旋翼诊断第一入口",
      "affects": ["vibration", "attitude", "ekf"],
      "fields": {
        "VibeX": {
          "description": "X 轴滤波振动水平（m/s²）。官方参考：<15 良好，15~30 需整改，>30 危险",
          "unit": "m/s/s",
          "thresholds": [
            { "level": "warning", "op": "gt", "value": 15 },
            { "level": "critical", "op": "gt", "value": 30 }
          ],
          "affects": ["vibration"],
          "analysis": [
            { "condition": "Vibe 持续 >15 且伴随 ATT 跟踪差/高度抖动", "meaning": "减震不良或桨/电机不平衡" },
            { "condition": "Vibe 随油门升高同步增大", "meaning": "桨/电机/轴承问题（转频相关）" }
          ],
          "related": ["VIBE.VibeY", "VIBE.VibeZ"]
        },
        "VibeY": {
          "description": "Y 轴滤波振动水平（m/s²），同 VibeX 阈值",
          "unit": "m/s/s",
          "thresholds": [
            { "level": "warning", "op": "gt", "value": 15 },
            { "level": "critical", "op": "gt", "value": 30 }
          ],
          "affects": ["vibration"]
        },
        "VibeZ": {
          "description": "Z 轴滤波振动水平（m/s²），同 VibeX 阈值",
          "unit": "m/s/s",
          "thresholds": [
            { "level": "warning", "op": "gt", "value": 15 },
            { "level": "critical", "op": "gt", "value": 30 }
          ],
          "affects": ["vibration"]
        },
        "Clip": {
          "description": "加速度计削波（clipping）事件计数——出现即说明振动严重到传感器饱和",
          "unit": "count",
          "thresholds": [{ "level": "warning", "op": "gt", "value": 0 }],
          "affects": ["vibration"],
          "analysis": [
            { "condition": "Clip 持续增长", "meaning": "振动极其严重，加速度计饱和，EKF 高度/速度估计受损" }
          ]
        }
      }
    },
    "IMU": {
      "description": "惯性测量单元原始数据：陀螺/加计读数、健康与错误计数",
      "affects": ["attitude", "ekf", "vibration"],
      "fields": {
        "GyrX": { "description": "陀螺 X 轴角速率（rad/s）", "unit": "rad/s" },
        "GyrY": { "description": "陀螺 Y 轴角速率（rad/s）", "unit": "rad/s" },
        "GyrZ": { "description": "陀螺 Z 轴角速率（rad/s）", "unit": "rad/s" },
        "AccX": { "description": "加计 X 轴加速度（m/s²）", "unit": "m/s/s" },
        "AccY": { "description": "加计 Y 轴加速度（m/s²）", "unit": "m/s/s" },
        "AccZ": { "description": "加计 Z 轴加速度（m/s²）", "unit": "m/s/s" },
        "T": { "description": "IMU 温度（℃）——温度漂移大说明预热不足", "unit": "celsius" },
        "EG": { "description": "陀螺错误计数——非零增长说明传感器异常", "unit": "count" },
        "EA": { "description": "加计错误计数——非零增长说明传感器异常", "unit": "count" },
        "GH": { "description": "陀螺健康标志（1=健康）", "unit": "bool" },
        "AH": { "description": "加计健康标志（1=健康）", "unit": "bool" }
      }
    },
    "ACC": {
      "description": "原始加速度计数据（未滤波）",
      "affects": ["vibration", "attitude", "ekf", "position"],
      "fields": {
        "AccX": { "description": "X 轴加速度（m/s²）", "unit": "m/s/s" },
        "AccY": { "description": "Y 轴加速度（m/s²）", "unit": "m/s/s" },
        "AccZ": { "description": "Z 轴加速度（m/s²）", "unit": "m/s/s" }
      }
    },
    "GYR": {
      "description": "原始陀螺数据（未滤波）",
      "affects": ["attitude", "ekf", "vibration"],
      "fields": {
        "GyrX": { "description": "X 轴角速率（rad/s）", "unit": "rad/s" },
        "GyrY": { "description": "Y 轴角速率（rad/s）", "unit": "rad/s" },
        "GyrZ": { "description": "Z 轴角速率（rad/s）", "unit": "rad/s" }
      }
    },
    "BARO": {
      "description": "气压计：高度/气压/温度，EKF 高度的主要来源",
      "affects": ["altitude", "ekf"],
      "fields": {
        "Alt": { "description": "气压计高度（米）", "unit": "m", "affects": ["altitude"] },
        "AltAMSL": { "description": "海拔高度（米，MSL）", "unit": "m" },
        "Press": { "description": "大气压（Pa）", "unit": "Pa" },
        "Temp": { "description": "气压计温度（℃）", "unit": "celsius" },
        "CRt": { "description": "气压导出的爬升率（m/s）", "unit": "m/s", "affects": ["altitude"] },
        "Offset": { "description": "气压高度偏置（米，校准引入）", "unit": "m" },
        "H": { "description": "健康标志（1=健康）", "unit": "bool" }
      }
    },
    "MAG": {
      "description": "罗盘（磁力计）：磁场强度/偏置/电机干扰补偿，航向估计来源",
      "affects": ["heading", "ekf"],
      "fields": {
        "MagX": { "description": "X 轴磁场强度（mGauss）", "unit": "mGauss", "related": ["MAG.OfsX"] },
        "MagY": { "description": "Y 轴磁场强度（mGauss）", "unit": "mGauss", "related": ["MAG.OfsY"] },
        "MagZ": { "description": "Z 轴磁场强度（mGauss）", "unit": "mGauss", "related": ["MAG.OfsZ"] },
        "OfsX": { "description": "X 轴磁场偏置（mGauss）——校准结果", "unit": "mGauss" },
        "OfsY": { "description": "Y 轴磁场偏置（mGauss）", "unit": "mGauss" },
        "OfsZ": { "description": "Z 轴磁场偏置（mGauss）", "unit": "mGauss" },
        "MOX": { "description": "电机干扰补偿 X（mGauss）", "unit": "mGauss" },
        "MOY": { "description": "电机干扰补偿 Y（mGauss）", "unit": "mGauss" },
        "MOZ": { "description": "电机干扰补偿 Z（mGauss）", "unit": "mGauss" },
        "Health": { "description": "罗盘健康标志（1=健康）", "unit": "bool" }
      }
    },
    "RCIN": {
