{
  "format": "tlog",
  "version": 1,
  "groups": {
    "ATTITUDE": {
      "description": "姿态（MAVLink ATTITUDE，APM/PX4 共用）：欧拉角与角速度，稳定性的第一入口",
      "affects": ["attitude", "stability"],
      "fields": {
        "Roll": {
          "description": "横滚角（度，右倾为正）",
          "unit": "deg",
          "affects": ["attitude"],
          "analysis": [
            { "condition": "悬停时 Roll 持续偏向一侧", "meaning": "重心偏移/电机推力不对称/风" },
            { "condition": "Roll 快速振荡", "meaning": "姿态环增益不当或振动耦合" }
          ],
          "related": ["ATTITUDE.Rollspeed", "VIBRATION.VibrationX"]
        },
        "Pitch": {
          "description": "俯仰角（度，抬头为正）",
          "unit": "deg",
          "affects": ["attitude"],
          "analysis": [
            { "condition": "悬停时 Pitch 非零且持续", "meaning": "重心偏移或云台/载荷安装偏角" }
          ],
          "related": ["ATTITUDE.Pitchspeed"]
        },
        "Yaw": {
          "description": "偏航角（度，0=北）",
          "unit": "deg",
          "affects": ["attitude", "heading"],
          "analysis": [
            { "condition": "Yaw 缓慢漂移（地速接近 0 时）", "meaning": "罗盘误差或磁干扰" }
          ],
          "related": ["ATTITUDE.Yawspeed", "GPS_RAW_INT.Cog"]
        },
        "Rollspeed": { "description": "横滚角速度（度/秒）", "unit": "deg/s", "affects": ["attitude", "vibration"] },
        "Pitchspeed": { "description": "俯仰角速度（度/秒）", "unit": "deg/s", "affects": ["attitude", "vibration"] },
        "Yawspeed": { "description": "偏航角速度（度/秒）", "unit": "deg/s", "affects": ["attitude"] }
      }
    },
    "ATTITUDE_QUATERNION": {
      "description": "四元数姿态（APM/PX4 共用）：Q1..Q4 为姿态四元数分量（w,x,y,z 顺序）",
      "affects": ["attitude"],
      "fields": {
        "Q1": { "description": "四元数 w 分量（1=无旋转）", "unit": "", "affects": ["attitude"] },
        "Q2": { "description": "四元数 x 分量", "unit": "", "affects": ["attitude"] },
        "Q3": { "description": "四元数 y 分量", "unit": "", "affects": ["attitude"] },
        "Q4": { "description": "四元数 z 分量", "unit": "", "affects": ["attitude"] },
        "Rollspeed": { "description": "横滚角速度（弧度/秒）", "unit": "rad/s", "affects": ["attitude"] },
        "Pitchspeed": { "description": "俯仰角速度（弧度/秒）", "unit": "rad/s", "affects": ["attitude"] },
        "Yawspeed": { "description": "偏航角速度（弧度/秒）", "unit": "rad/s", "affects": ["attitude"] }
      }
    },
    "GPS_RAW_INT": {
      "description": "GPS 原始定位（APM/PX4 共用）：卫星质量、精度、位置与速度",
      "affects": ["position", "navigation", "ekf"],
      "fields": {
        "FixType": { "description": "定位类型", "unit": "enum", "values": ["0=无","1=无锁","2=2D","3=3D","4=DGPS","5=RTK浮点","6=RTK固定"], "affects": ["position","navigation"], "analysis": [{"condition":"FixType 掉回 0/1","meaning":"定位丢失，位置估计退化为航位推算"},{"condition":"FixType=6 突然掉到 3","meaning":"RTK 失锁，精度从厘米级跌到米级"}] },
        "SatellitesVisible": {
          "description": "可见卫星数量",
          "unit": "count",
          "thresholds": [
            { "level": "warning", "op": "lt", "value": 8 },
            { "level": "critical", "op": "lt", "value": 5 }
          ],
          "affects": ["position", "navigation"],
          "analysis": [
            { "condition": "SatellitesVisible 下降 && Eph 升高", "meaning": "GPS 信号质量下降" }
          ],
          "related": ["GPS_RAW_INT.Eph", "GPS_RAW_INT.HAcc"]
        },
        "Eph": {
          "description": "水平精度（÷100 后：老固件为 HDOP 无量纲，新固件为精度估计米）",
          "unit": "m 或 HDOP",
          "affects": ["position", "ekf"],
          "analysis": [
            { "condition": "Eph 持续偏高", "meaning": "定位几何差或信号弱，水平位置漂移风险" }
          ],
          "related": ["GPS_RAW_INT.HAcc", "GPS_RAW_INT.SatellitesVisible"]
        },
        "Epv": { "description": "垂直精度（同 Eph 的单位约定）", "unit": "m 或 VDOP", "affects": ["position"] },
        "HAcc": {
          "description": "水平位置精度（米）",
          "unit": "m",
          "thresholds": [
            { "level": "warning", "op": "gt", "value": 2 },
            { "level": "critical", "op": "gt", "value": 5 }
          ],
          "affects": ["position"]
        },
        "VAcc": { "description": "垂直位置精度（米）", "unit": "m", "affects": ["position"] },
        "VelAcc": { "description": "速度精度（米/秒）", "unit": "m/s", "affects": ["navigation"] },
        "Lat": { "description": "纬度（度）", "unit": "deg", "affects": ["position"] },
        "Lon": { "description": "经度（度）", "unit": "deg", "affects": ["position"] },
        "Alt": { "description": "GPS 海拔（椭球高，米）", "unit": "m", "affects": ["position"], "related": ["ALTITUDE.AltitudeAmsl"] },
        "AltEllipsoid": { "description": "椭球高（米）", "unit": "m", "affects": ["position"] },
        "Vel": { "description": "地速（米/秒）", "unit": "m/s", "affects": ["navigation"] },
        "Cog": { "description": "地面航向（0.01 度，0=北，65535=未知）", "unit": "cdeg", "affects": ["navigation"] },
        "Yaw": { "description": "GPS 双天线航向（0.01 度）；无双天线时为 0/未知", "unit": "cdeg", "affects": ["heading"] }
      }
    },
    "GPS2_RAW": {
      "description": "第二路 GPS 原始定位（APM 双 GPS，字段含义同 GPS_RAW_INT）",
      "affects": ["position", "navigation"],
      "fields": {
        "FixType": { "description": "定位类型（同 GPS_RAW_INT.FixType 枚举）", "unit": "enum", "affects": ["position"] },
        "SatellitesVisible": { "description": "可见卫星数", "unit": "count", "affects": ["position"] },
        "Eph": { "description": "水平精度（同 GPS_RAW_INT.Eph 约定）", "unit": "m 或 HDOP", "affects": ["position"] },
        "Lat": { "description": "纬度（度）", "unit": "deg", "affects": ["position"] },
        "Lon": { "description": "经度（度）", "unit": "deg", "affects": ["position"] },
        "Alt": { "description": "海拔（米）", "unit": "m", "affects": ["position"] },
        "Vel": { "description": "地速（米/秒）", "unit": "m/s", "affects": ["navigation"] }
      }
    },
    "GLOBAL_POSITION_INT": {
      "description": "融合后的全局位置估计（APM/PX4 共用）：EKF 输出的位置/速度/航向，分析漂移用",
      "affects": ["position", "navigation", "ekf"],
      "fields": {
        "Lat": { "description": "估计纬度（度）", "unit": "deg", "affects": ["position"] },
        "Lon": { "description": "估计经度（度）", "unit": "deg", "affects": ["position"] },
        "Alt": { "description": "估计海拔 AMSL（米）", "unit": "m", "affects": ["altitude"], "related": ["ALTITUDE.AltitudeAmsl"] },
        "RelativeAlt": { "description": "相对起飞点高度（米）", "unit": "m", "affects": ["altitude"], "related": ["VFR_HUD.Alt"] },
        "Vx": { "description": "北向速度（米/秒）", "unit": "m/s", "affects": ["navigation"] },
        "Vy": { "description": "东向速度（米/秒）", "unit": "m/s", "affects": ["navigation"] },
        "Vz": { "description": "垂直速度（米/秒，负=下降）", "unit": "m/s", "affects": ["altitude"] },
        "Hdg": { "description": "航向（0.01 度，0=北，65535=未知）", "unit": "cdeg", "affects": ["heading"] }
      }
    },
    "LOCAL_POSITION_NED": {
      "description": "局部 NED 坐标位置估计（APM/PX4 共用）：以起飞点为原点的北-东-地系",
      "affects": ["position", "ekf"],
      "fields": {
        "X": { "description": "北向位移（米，NED）", "unit": "m", "affects": ["position"] },
        "Y": { "description": "东向位移（米，NED）", "unit": "m", "affects": ["position"] },
        "Z": { "description": "垂直位移（米，NED：负=高于起飞点）", "unit": "m", "affects": ["altitude"] },
        "Vx": { "description": "北向速度（米/秒）", "unit": "m/s", "affects": ["navigation"] },
        "Vy": { "description": "东向速度（米/秒）", "unit": "m/s", "affects": ["navigation"] },
        "Vz": { "description": "垂直速度（米/秒，负=上升）", "unit": "m/s", "affects": ["altitude"] }
      }
    },
    "POSITION_TARGET_GLOBAL_INT": {
      "description": "控制器当前目标位置/速度（APM/PX4 共用）：与 GLOBAL_POSITION_INT 对比看跟踪误差与漂移",
      "affects": ["navigation", "control"],
      "fields": {
        "LatInt": { "description": "目标纬度（度）", "unit": "deg", "affects": ["navigation"] },
        "LonInt": { "description": "目标经度（度）", "unit": "deg", "affects": ["navigation"] },
        "Alt": { "description": "目标高度（米）", "unit": "m", "affects": ["altitude"] },
        "Vx": { "description": "目标北向速度（米/秒）", "unit": "m/s", "affects": ["navigation"] },
        "Vy": { "description": "目标东向速度（米/秒）", "unit": "m/s", "affects": ["navigation"] },
        "Vz": { "description": "目标垂直速度（米/秒）", "unit": "m/s", "affects": ["altitude"] },
        "Yaw": { "description": "目标航向（弧度）", "unit": "rad", "affects": ["heading"] }
      }
    },
    "VFR_HUD": {
      "description": "仪表盘数据（APM/PX4 共用）：空速/地速/油门/高度/爬升率",
      "affects": ["navigation", "throttle", "altitude"],
      "fields": {
        "Airspeed": {
          "description": "空速（米/秒）",
          "unit": "m/s",
          "affects": ["airspeed"],
          "appliesTo": ["fixedwing", "vtol"],
          "related": ["AIRSPEED.Airspeed"]
        },
        "Groundspeed": { "description": "地速（米/秒）", "unit": "m/s", "affects": ["navigation"] },
        "Heading": { "description": "航向（度，0=北）", "unit": "deg", "affects": ["heading"] },
        "Throttle": {
          "description": "油门（%，0~100）",
          "unit": "percent",
          "affects": ["throttle", "power"],
          "analysis": [
            { "condition": "悬停油门随时间升高", "meaning": "电池电压下降（正常）或推力衰减/超载" },
            { "condition": "固定翼巡航油门偏高", "meaning": "阻力增大或配平不当" }
          ],
          "related": ["SYS_STATUS.CurrentBattery"]
        },
        "Alt": { "description": "相对起飞点高度（米）", "unit": "m", "affects": ["altitude"] },
        "Climb": { "description": "爬升率（米/秒，正=上升）", "unit": "m/s", "affects": ["altitude"] }
      }
    },
    "SYS_STATUS": {
      "description": "系统状态（APM/PX4 共用）：负载/电池/链路丢包与错误计数",
      "affects": ["system", "power", "link"],
      "fields": {
        "Load": {
          "description": "CPU 占用（%，飞控主循环负载）",
          "unit": "percent",
          "thresholds": [
            { "level": "warning", "op": "gt", "value": 80 },
            { "level": "critical", "op": "gt", "value": 95 }
          ],
          "affects": ["system"]
        },
        "VoltageBattery": {
          "description": "电池电压（0.01V，厘伏）",
          "unit": "cV",
          "affects": ["power"],
          "related": ["BATTERY_STATUS.Voltages"]
        },
        "CurrentBattery": { "description": "电流（安培）", "unit": "A", "affects": ["power"] },
        "BatteryRemaining": {
          "description": "剩余电量（%，-1=未知）",
          "unit": "percent",
          "thresholds": [
            { "level": "warning", "op": "lt", "value": 25 },
            { "level": "critical", "op": "lt", "value": 15 }
          ],
          "affects": ["power", "safety"]
        },
        "DropRateComm": { "description": "链路丢包率（%，MAVLink 传输）", "unit": "percent", "affects": ["link"] },
        "ErrorsComm": { "description": "链路累计错误数", "unit": "count", "affects": ["link"] },
        "ErrorsCount1": { "description": "传感器错误计数（第 1 组，含义视固件）", "unit": "count", "affects": ["system"] },
        "ErrorsCount2": { "description": "传感器错误计数（第 2 组）", "unit": "count", "affects": ["system"] },
        "ErrorsCount3": { "description": "传感器错误计数（第 3 组）", "unit": "count", "affects": ["system"] },
        "ErrorsCount4": { "description": "传感器错误计数（第 4 组）", "unit": "count", "affects": ["system"] }
      }
    },
    "BATTERY_STATUS": {
      "description": "电池详情（PX4 常见）：电压阵列/电流/累计消耗/剩余与充电状态",
      "affects": ["power", "safety"],
      "fields": {
        "Voltages": { "description": "电芯电压阵列（毫伏，Voltages[0] 通常为总/第一芯）", "unit": "mV", "affects": ["power"] },
        "CurrentBattery": { "description": "电流（安培，-1=未知）", "unit": "A", "affects": ["power"] },
        "CurrentConsumed": { "description": "累计消耗电量（毫安时）", "unit": "mAh", "affects": ["duration"] },
        "EnergyConsumed": { "description": "累计消耗能量（百焦耳 hJ）", "unit": "hJ", "affects": ["duration"] },
        "BatteryRemaining": {
          "description": "剩余电量（%）",
          "unit": "percent",
          "thresholds": [
            { "level": "warning", "op": "lt", "value": 25 },
            { "level": "critical", "op": "lt", "value": 15 }
          ],
          "affects": ["duration", "safety"]
        },
        "TimeRemaining": { "description": "预计剩余飞行时间（秒，-1=未知）", "unit": "s", "affects": ["duration"] },
        "Temperature": { "description": "电池温度（摄氏度，INT16_MAX=未知）", "unit": "celsius", "affects": ["power"] },
        "ChargeState": { "description": "充电状态", "unit": "enum", "values": ["0=未定义","1=正在充电","8=满电"], "affects": ["power"] }
      }
    },
    "POWER_STATUS": {
      "description": "供电状态（APM 常见）：主电源与舵机电源电压",
      "affects": ["power"],
      "fields": {
        "Vcc": {
          "description": "主电源电压（毫伏）",
          "unit": "mV",
          "thresholds": [
            { "level": "warning", "op": "lt", "value": 4600 },
            { "level": "critical", "op": "lt", "value": 4400 }
          ],
          "affects": ["power"]
        },
        "Vservo": { "description": "舵机电源电压（毫伏）", "unit": "mV", "affects": ["power"] },
        "Flags": { "description": "供电故障位标志", "unit": "bitmask", "affects": ["power"] }
      }
    },
    "RAW_IMU": {
      "description": "原始 IMU（APM/PX4 共用）：未校准的加计/陀螺/罗盘原始值，看噪声与饱和",
      "affects": ["vibration", "attitude"],
      "fields": {
        "Xacc": { "description": "X 轴加计原始值（毫g 或 ADC 原始计数，视固件）", "unit": "mG", "affects": ["vibration"] },
        "Yacc": { "description": "Y 轴加计原始值（毫g）", "unit": "mG", "affects": ["vibration"] },
        "Zacc": { "description": "Z 轴加计原始值（静置应约 ±1000 毫g）", "unit": "mG", "affects": ["vibration"] },
        "Xgyro": { "description": "X 轴陀螺原始值（毫弧度/秒）", "unit": "mrad/s", "affects": ["attitude"] },
        "Ygyro": { "description": "Y 轴陀螺原始值（毫弧度/秒）", "unit": "mrad/s", "affects": ["attitude"] },
        "Zgyro": { "description": "Z 轴陀螺原始值（毫弧度/秒）", "unit": "mrad/s", "affects": ["attitude"] },
        "Xmag": { "description": "X 轴罗盘原始值（毫高斯）", "unit": "mgauss", "affects": ["heading"] },
        "Ymag": { "description": "Y 轴罗盘原始值（毫高斯）", "unit": "mgauss", "affects": ["heading"] },
        "Zmag": { "description": "Z 轴罗盘原始值（毫高斯）", "unit": "mgauss", "affects": ["heading"] },
        "Temperature": { "description": "IMU 温度（摄氏度）", "unit": "celsius", "affects": ["system"] }
      }
    },
    "SCALED_IMU": {
      "description": "校准后 IMU（APM/PX4 共用，SCALED_IMU2/3 为第二/三路，自动回退本条目）：毫g / 毫弧度每秒",
      "affects": ["vibration", "attitude"],
      "fields": {
        "Xacc": {
          "description": "X 轴加速度（毫g，静置约 0）",
          "unit": "mG",
          "affects": ["vibration"],
          "analysis": [
            { "condition": "|Xacc| 交流分量大（峰峰 > 数百 mG）", "meaning": "机体振动大，可能影响姿态估计与螺旋桨/电机健康" }
          ],
          "related": ["VIBRATION.VibrationX"]
        },
        "Yacc": { "description": "Y 轴加速度（毫g）", "unit": "mG", "affects": ["vibration"] },
        "Zacc": {
          "description": "Z 轴加速度（毫g，静置约 +1000）",
          "unit": "mG",
          "thresholds": [
            { "level": "warning", "op": "gt", "value": 1300 },
            { "level": "critical", "op": "gt", "value": 1600 }
          ],
          "affects": ["vibration"]
        },
        "Xgyro": { "description": "X 轴角速度（毫弧度/秒）", "unit": "mrad/s", "affects": ["attitude"] },
        "Ygyro": { "description": "Y 轴角速度（毫弧度/秒）", "unit": "mrad/s", "affects": ["attitude"] },
        "Zgyro": { "description": "Z 轴角速度（毫弧度/秒）", "unit": "mrad/s", "affects": ["attitude"] },
        "Xmag": { "description": "X 轴磁场（毫高斯）", "unit": "mgauss", "affects": ["heading"] },
        "Ymag": { "description": "Y 轴磁场（毫高斯）", "unit": "mgauss", "affects": ["heading"] },
        "Zmag": { "description": "Z 轴磁场（毫高斯）", "unit": "mgauss", "affects": ["heading"] },
        "Temperature": { "description": "IMU 温度（摄氏度）", "unit": "celsius", "affects": ["system"] }
      }
    },
    "HIGHRES_IMU": {
      "description": "高分辨率 IMU（APM 常见）：SI 单位的加计/陀螺/罗盘 + 气压，诊断振动首选（单位直观）",
      "affects": ["vibration", "attitude", "altitude"],
      "fields": {
        "Xacc": {
          "description": "X 轴加速度（米/秒²，静置约 0）",
          "unit": "m/s2",
          "affects": ["vibration"],
          "analysis": [
            { "condition": "Xacc 峰峰 > 3 m/s² 持续", "meaning": "振动偏大；>5 m/s² 可能触发 APM 振动补偿告警" }
          ]
        },
        "Yacc": { "description": "Y 轴加速度（米/秒²）", "unit": "m/s2", "affects": ["vibration"] },
        "Zacc": {
          "description": "Z 轴加速度（米/秒²，静置约 +9.8）",
          "unit": "m/s2",
          "thresholds": [
            { "level": "warning", "op": "gt", "value": 13 },
            { "level": "critical", "op": "gt", "value": 16 }
          ],
          "affects": ["vibration"]
        },
        "Xgyro": { "description": "X 轴角速度（弧度/秒）", "unit": "rad/s", "affects": ["attitude"] },
        "Ygyro": { "description": "Y 轴角速度（弧度/秒）", "unit": "rad/s", "affects": ["attitude"] },
        "Zgyro": { "description": "Z 轴角速度（弧度/秒）", "unit": "rad/s", "affects": ["attitude"] },
        "Xmag": { "description": "X 轴磁场（高斯）", "unit": "gauss", "affects": ["heading"] },
        "Ymag": { "description": "Y 轴磁场（高斯）", "unit": "gauss", "affects": ["heading"] },
        "Zmag": { "description": "Z 轴磁场（高斯）", "unit": "gauss", "affects": ["heading"] },
        "AbsPressure": { "description": "绝对气压（百帕）", "unit": "hPa", "affects": ["altitude"] },
